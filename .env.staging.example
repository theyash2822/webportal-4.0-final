# Web portal — STAGING build template (variable NAMES + staging hosts only).
#
# Vite bakes VITE_* in at build time, so a staging bundle is produced by
# building with these values; there is no runtime switch.
#
#   npm run build:staging
#
# src/services/config.js refuses to build/boot if a non-production VITE_APP_ENV
# is pointed at api.tallydekho.com.

VITE_APP_ENV=staging
VITE_API_URL=https://staging-api.tallydekho.com/app
VITE_WS_URL=wss://staging-api.tallydekho.com
